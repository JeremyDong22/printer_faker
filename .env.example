# Printer API Environment Configuration
# Copy this file to .env and fill in your values

# API Authentication
PRINTER_API_PASSWORD=smartbcg

# Supabase Configuration (for local order processing)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Axiom Monitoring and Observability (optional but recommended)
# Get your API token from: https://app.axiom.co/settings/api-tokens
# Create a dataset at: https://app.axiom.co/datasets
AXIOM_TOKEN=your-axiom-token-here
AXIOM_DATASET=printer-faker-prod
AXIOM_ORG_ID=your-org-id-here  # Optional, only if you have multiple orgs
AXIOM_ENABLED=true  # Set to false to disable Axiom logging

# Service Configuration
ENVIRONMENT=production  # production, staging, or development
DATABASE_PATH=/home/smartahc/smartice/printer_faker/receipts.db
MAX_CONCURRENT_CONNECTIONS=50
MAX_MEMORY_RECEIPTS=500